# Copy this file to .env and adjust. Never commit .env.

# Privacy mode: demo (cloud LLM, synthetic data only) | cloud (cloud LLM, real data,
# schema + aggregates only) | local (Ollama only, no external egress).
PRIVACY_MODE=demo

# live | offline. Switches to offline automatically when there is no key and mode is not local.
LLM_MODE=live

# LiteLLM model string, e.g. provider/model-name. Fill in with a model you have access to.
LLM_MODEL=provider/model-name

# Secret. Leave empty to run in offline mode.
LLM_API_KEY=

# Only for local models, e.g. http://localhost:11434 (Ollama). Required when PRIVACY_MODE=local.
LLM_API_BASE=

# Seconds per LLM call.
LLM_TIMEOUT_S=60

# Retries with exponential backoff and jitter.
LLM_MAX_RETRIES=3

# SQL candidates generated per question (majority vote decides).
SQL_CANDIDATES=3

# Hard stop for LLM tokens in one session.
SESSION_TOKEN_BUDGET=200000

# cloud mode only: send distinct category values (e.g. 'completed') to the LLM.
SEND_CATEGORY_VALUES=false

# Upload limits.
MAX_FILE_MB=50
MAX_ROWS=1000000

# DuckDB limits.
QUERY_TIMEOUT_S=10
RESULT_ROW_LIMIT=10000
DUCKDB_MEMORY_LIMIT=1GB

# Minimum group size in findings that may be sent to a cloud LLM.
K_ANON_MIN=5

# Optional shared password for the app. Empty = no password gate.
APP_PASSWORD=

LOG_LEVEL=INFO
