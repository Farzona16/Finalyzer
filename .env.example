# Copy this file to .env and adjust. Never commit .env.
# Ready-made presets: .env.free.example (Render Free, $0) and .env.full.example (paid host).

# --- v3 backend (FastAPI) ---
# APP_ENV=development | test | production
APP_ENV=development
# python -m app.cli generate-keys  (from backend/)
APP_SECRET_KEY=
# Required when STORAGE_MODE=persistent (32 bytes, base64)
APP_MASTER_KEY=
# sqlite by default; Postgres: postgresql+psycopg://user:pass@host/db
DATABASE_URL=
STORAGE_MODE=ephemeral

# free (<= 768 MB RAM, detected from the cgroup limit when empty) | full
RESOURCE_PROFILE=

# Privacy mode: demo (synthetic data only) | cloud (real data, schema + aggregates only)
# | local (Ollama only, no external egress).
PRIVACY_MODE=demo
# strict (schema + aggregates) | balanced (+ masked category values) | open (+ up to 50 rows)
PRIVACY_LEVEL=strict

# --- AI providers (no LiteLLM; each link is optional) ---
# live | local | offline. Offline when no link of the chain has a key and a model.
LLM_MODE=live
# Tried in order; offline is always added last (frames, router and golden answers).
LLM_PROVIDER_CHAIN=anthropic,grok,offline

# Claude (official SDK). Model ids come from the presets or `python scripts/claude_smoke.py`.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=
CLAUDE_MODEL_MAIN=
CLAUDE_MODEL_DEEP=

# Grok (xAI, OpenAI-compatible chat completions). Check ids with `python scripts/grok_smoke.py`.
XAI_API_KEY=
OPENAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL_FAST=
GROK_MODEL_MAIN=
GROK_MODEL_DEEP=

# Ollama (PRIVACY_MODE=local) or any other OpenAI-compatible endpoint (chain link "custom").
# Migrating from LiteLLM: put "custom" in LLM_PROVIDER_CHAIN, use the plain model id (no
# "provider/" prefix), the endpoint's OpenAI-compatible base URL, and add its host below.
LLM_MODEL=
LLM_API_KEY=
LLM_API_BASE=

# Seconds per call (Render's proxy cuts requests at 30 s) and retries with backoff + jitter.
LLM_TIMEOUT_S=25
LLM_MAX_RETRIES=2
# Circuit breaker: open after N consecutive failures, retry after S seconds.
CIRCUIT_FAILURES=3
CIRCUIT_RESET_S=60

# --- Egress and data clearance ---
EGRESS_ALLOWED_HOSTS=api.anthropic.com,api.x.ai
# Real data needs an admin-confirmed clearance per provider (synthetic_only | strict_ok |
# balanced_ok). Check the provider's current data terms before raising it.
PROVIDER_CLEARANCE=anthropic:synthetic_only,grok:synthetic_only
# on = no external AI call until an admin turns it off.
KILL_SWITCH_DEFAULT=off

# --- Token budgets (hard stop; no prices are stored) ---
SESSION_TOKEN_BUDGET=30000
DATASET_TOKEN_BUDGET=80000
DAILY_TOKEN_BUDGET=200000
HARD_STOP_ON_BUDGET=true

# SQL candidates per Ask question (ASK_CANDIDATES wins). 1 = one live call.
SQL_CANDIDATES=1
ASK_CANDIDATES=

# cloud mode only: send distinct category values (e.g. 'completed') to the LLM.
SEND_CATEGORY_VALUES=false

# Optional AI rephrasing of Uzbek insight cards. Off until eval_uzbek.py shows it helps.
UZ_POLISH=false

# Upload limits.
MAX_FILE_MB=50
MAX_ROWS=1000000

# DuckDB limits.
QUERY_TIMEOUT_S=10
RESULT_ROW_LIMIT=10000
DUCKDB_MEMORY_LIMIT=1GB

# Minimum group size in findings that may be sent to a cloud LLM.
K_ANON_MIN=5

# Optional shared password for the app. Empty = no password gate.
APP_PASSWORD=

LOG_LEVEL=INFO
