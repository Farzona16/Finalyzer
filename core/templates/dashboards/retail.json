{
  "id": "retail",
  "grid_columns": 12,
  "tiles": [
    {
      "id": "kpi_row",
      "type": "kpi_row",
      "title_key": "dashboard.tiles.kpi_row",
      "title": {
        "en": "Key numbers",
        "uz": "Asosiy koʻrsatkichlar"
      },
      "size": {
        "w": 12,
        "h": 2
      },
      "requires": [],
      "cross_filter": false,
      "metric_ids": [
        "$tiles"
      ]
    },
    {
      "id": "revenue_trend",
      "type": "line",
      "title_key": "dashboard.tiles.revenue_trend",
      "title": {
        "en": "Revenue trend",
        "uz": "Daromad dinamikasi"
      },
      "size": {
        "w": 8,
        "h": 4
      },
      "requires": [
        "date"
      ],
      "cross_filter": false,
      "metric_ids": [
        "$primary"
      ],
      "dimension": "time:month",
      "compare": "previous_year"
    },
    {
      "id": "revenue_by_category",
      "type": "donut",
      "title_key": "dashboard.tiles.revenue_by_category",
      "title": {
        "en": "Revenue share by category",
        "uz": "Toifalar boʻyicha daromad ulushi"
      },
      "size": {
        "w": 4,
        "h": 4
      },
      "requires": [
        "metric:revenue"
      ],
      "cross_filter": true,
      "metric_ids": [
        "$primary"
      ],
      "dimension": "auto",
      "prefer": [
        "category"
      ]
    },
    {
      "id": "top_products",
      "type": "bar_h",
      "title_key": "dashboard.tiles.top_products",
      "title": {
        "en": "Top 10 products",
        "uz": "Eng koʻp sotilgan 10 mahsulot"
      },
      "size": {
        "w": 6,
        "h": 4
      },
      "requires": [
        "column:product_name"
      ],
      "cross_filter": true,
      "metric_ids": [
        "$primary"
      ],
      "dimension": "column:product_name",
      "limit": 10
    },
    {
      "id": "revenue_by_channel",
      "type": "stacked_bar",
      "title_key": "dashboard.tiles.revenue_by_channel",
      "title": {
        "en": "Revenue by channel and month",
        "uz": "Kanallar va oylar boʻyicha daromad"
      },
      "size": {
        "w": 6,
        "h": 4
      },
      "requires": [
        "date",
        "column:channel"
      ],
      "cross_filter": true,
      "metric_ids": [
        "$primary"
      ],
      "dimension": "column:channel",
      "stack_by": "time:month"
    },
    {
      "id": "margin_gauge",
      "type": "gauge",
      "title_key": "dashboard.tiles.margin_gauge",
      "title": {
        "en": "Gross margin",
        "uz": "Yalpi foyda ulushi"
      },
      "size": {
        "w": 3,
        "h": 3
      },
      "requires": [
        "metric:gross_margin_pct"
      ],
      "cross_filter": false,
      "metric_ids": [
        "gross_margin_pct"
      ]
    },
    {
      "id": "revenue_by_store",
      "type": "bullet",
      "title_key": "dashboard.tiles.revenue_by_store",
      "title": {
        "en": "Revenue by store vs average",
        "uz": "Doʻkonlar daromadi, oʻrtachaga nisbatan"
      },
      "size": {
        "w": 5,
        "h": 3
      },
      "requires": [
        "column:store_name"
      ],
      "cross_filter": true,
      "metric_ids": [
        "$primary"
      ],
      "dimension": "column:store_name"
    },
    {
      "id": "weekday_heatmap",
      "type": "heatmap",
      "title_key": "dashboard.tiles.weekday_heatmap",
      "title": {
        "en": "Activity by weekday",
        "uz": "Hafta kunlari boʻyicha faollik"
      },
      "size": {
        "w": 4,
        "h": 3
      },
      "requires": [
        "date"
      ],
      "cross_filter": false,
      "metric_ids": [
        "$primary"
      ],
      "dimension": "weekday_by_week"
    },
    {
      "id": "top_customers",
      "type": "table",
      "title_key": "dashboard.tiles.top_customers",
      "title": {
        "en": "Top customers by spend",
        "uz": "Eng koʻp xarid qilgan mijozlar"
      },
      "size": {
        "w": 12,
        "h": 4
      },
      "requires": [
        "customer_id"
      ],
      "cross_filter": false,
      "metric_ids": [
        "$primary"
      ],
      "dimension": "customer_id",
      "limit": 10,
      "pii_free": true
    }
  ]
}
